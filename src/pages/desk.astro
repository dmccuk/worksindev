---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const tools = [
	{ name: 'Jeera', what: 'Ticket queue and sprints', sprint: 1 },
	{ name: 'GitBit', what: 'Hosts your Git repositories', sprint: 2 },
	{ name: 'Jonkins', what: 'Builds, tests and deploys code', sprint: 3 },
	{ name: 'Ansibubble', what: 'Configures many servers at once', sprint: 5 },
	{ name: 'Dockle', what: 'Packages apps into containers', sprint: 6 },
	{ name: 'Naggios', what: 'Monitoring and alerts', sprint: 7 },
];
---

<Base title="Your desk: Works in Dev" description="Sprint 1 at Darts Unlimited. Work the ticket queue on a real Linux server in your browser.">
	<div class="desk">
		<h1 class="sr-only">Your desk at Darts Unlimited</h1>
		<header class="topbar">
			<a class="wordmark" href={base}>Works in Dev</a>
			<p class="sprint-name"><span id="sprint-name">Sprint 1: Onboarding</span> <span id="top-burndown" class="top-burndown"></span></p>
			<div class="top-actions">
				<label class="sr-only" for="sprint-picker">Sprint</label>
				<select id="sprint-picker" hidden></select>
				<button type="button" class="link layout-reset" id="reset-layout">Reset layout</button>
				<button type="button" class="danger" id="restart">Reset sprint</button>
			</div>
		</header>

		<nav class="tabs" aria-label="Panels">
			<button type="button" data-tab="panel-queue" aria-selected="true">Queue</button>
			<button type="button" data-tab="panel-ticket">Ticket</button>
			<button type="button" data-tab="panel-terminal">Terminal</button>
			<button type="button" data-tab="panel-chat">Chat</button>
			<button type="button" data-tab="panel-tools">Tools</button>
		</nav>

		<main class="workspace" data-split="main" data-sizes="22,48,30" data-vm-base={`${base}vm/`}>
			<section class="panel" id="panel-queue" aria-labelledby="h-queue">
				<header class="panel-head">
					<h2 id="h-queue">Jeera: sprint 1</h2>
					<button type="button" class="max" data-maximise aria-pressed="false">Maximise</button>
				</header>
				<div class="panel-body queue">
					<div class="burndown">
						<label for="burndown">Burndown</label>
						<progress id="burndown" value="0" max="1"></progress>
						<p id="burndown-text"></p>
					</div>
					<button type="button" class="btn review" id="review" hidden>Go to sprint review</button>
					<h3 class="col-head">To do <span id="count-todo"></span></h3>
					<ul class="cards" id="col-todo"></ul>
					<h3 class="col-head">In progress <span id="count-doing"></span></h3>
					<ul class="cards" id="col-doing"></ul>
					<h3 class="col-head">Done <span id="count-done"></span></h3>
					<ul class="cards" id="col-done"></ul>
				</div>
			</section>
			<div role="separator" aria-label="Resize queue"></div>

			<div class="stack" data-split="centre" data-direction="column" data-sizes="42,58">
				<section class="panel" id="panel-ticket" aria-labelledby="h-ticket">
					<header class="panel-head">
						<h2 id="h-ticket">Ticket</h2>
						<button type="button" class="stuck" id="stuck" hidden>Stuck?</button>
						<button type="button" class="max" data-maximise aria-pressed="false">Maximise</button>
					</header>
					<div class="panel-body" id="ticket-body"></div>
				</section>
				<div role="separator" aria-label="Resize ticket and terminal"></div>
				<section class="panel dark" id="panel-terminal" aria-labelledby="h-term">
					<header class="panel-head">
						<h2 id="h-term">Terminal: web01</h2>
						<p class="term-status" id="term-status" role="status"></p>
						<button type="button" class="max" data-maximise aria-pressed="false">Maximise</button>
					</header>
					<div class="term" id="term"></div>
				</section>
			</div>
			<div role="separator" aria-label="Resize centre and chat"></div>

			<div class="stack" data-split="right" data-direction="column" data-sizes="62,38">
				<section class="panel" id="panel-chat" aria-labelledby="h-chat">
					<header class="panel-head">
						<h2 id="h-chat">Chat</h2>
						<button type="button" class="max" data-maximise aria-pressed="false">Maximise</button>
					</header>
					<ol class="panel-body chat" id="chat-log" role="log" aria-live="polite"></ol>
				</section>
				<div role="separator" aria-label="Resize chat and tools"></div>
				<section class="panel" id="panel-tools" aria-labelledby="h-tools">
					<header class="panel-head">
						<h2 id="h-tools">Tools</h2>
						<button type="button" class="max" data-maximise aria-pressed="false">Maximise</button>
					</header>
					<div class="panel-body">
						<section class="jonkins" id="jonkins" aria-labelledby="jonkins-title" hidden>
							<h3 id="jonkins-title" class="jonkins-title"><span class="jonkins-logo">Jonkins</span> darts-shop builds</h3>
							<ol id="jonkins-runs" class="runs" aria-live="polite"></ol>
							<h4 id="jonkins-console-title" class="console-title">Console output</h4>
							<pre id="jonkins-console" class="console" tabindex="0" aria-labelledby="jonkins-console-title"></pre>
						</section>
						<section class="gitbit" id="gitbit" aria-labelledby="gitbit-title" hidden>
							<h3 id="gitbit-title" class="gitbit-title"><span class="gitbit-logo">GitBit</span> <span id="gitbit-repo"></span></h3>
							<div id="gitbit-body" aria-live="polite"></div>
						</section>
						<ul class="tools">
							{
								tools.map((t) => (
									<li data-unlocks={t.sprint}>
										<strong>{t.name}</strong>
										<span>{t.what}</span>
										<span class="unlock" />
									</li>
								))
							}
						</ul>
					</div>
				</section>
			</div>
		</main>
	</div>

	<dialog id="clock-in" aria-labelledby="clock-in-title">
		<p class="eyebrow-time" id="clock-in-time">Monday, 9:00am</p>
		<h2 id="clock-in-title">First day at Darts Unlimited</h2>
		<p id="clock-in-text">
			You're the new junior operations engineer. Your tickets are in the Jeera queue, your manager is in chat, and you'll
			be logged in to web01, a real Linux server running in this browser tab.
		</p>
		<form id="clock-in-form" class="clock-in-form" novalidate>
			<label for="username">Your username</label>
			<input
				id="username"
				name="username"
				value="newstarter"
				autocomplete="off"
				autocapitalize="none"
				spellcheck="false"
				aria-describedby="username-help username-error"
			/>
			<p id="username-help" class="small">
				Lowercase letters and numbers. Your password is <code>Welcome1</code>. Everyone's is. Please don't tell Priya.
			</p>
			<p id="username-error" class="error" role="alert"></p>
			<button type="submit" class="btn" id="clock-in-button">Clock in</button>
		</form>
		<p class="small">The first start downloads about 25 MB. Drag panel borders to resize them, or maximise any panel.</p>
	</dialog>

	<dialog id="review-dialog" aria-labelledby="review-title">
		<h2 id="review-title">Sprint review and retro</h2>
		<p id="review-intro">Derek wants to know what you learned.</p>
		<form id="retro-form"></form>
		<div id="promotion" hidden>
			<h2 id="promotion-title">Promoted</h2>
			<div class="stripe" aria-hidden="true"></div>
			<p id="promotion-text"></p>
			<h3>Real-world translation</h3>
			<table>
				<tbody id="translation"></tbody>
			</table>
			<div id="next-sprint"></div>
		</div>
		<button type="button" class="link" id="review-close">Close</button>
	</dialog>
</Base>

<script>
	import { startDesk } from '../game/desk';
	startDesk();
</script>

<style>
	:global(body) {
		overflow: hidden;
	}
	.desk {
		--sep: 6px;
		display: grid;
		grid-template-rows: auto auto 1fr;
		height: 100dvh;
	}
	.topbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1.5rem;
		padding: 0.5rem 1rem;
		background: var(--ink);
		color: var(--wall);
	}
	@media (prefers-color-scheme: dark) {
		.topbar {
			background: #0c1118;
			color: var(--ink);
		}
	}
	.wordmark {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.125rem;
		text-decoration: none;
	}
	.sprint-name {
		margin: 0;
		font-weight: 700;
	}
	.top-burndown {
		margin-left: 0.5rem;
		font-weight: 400;
		opacity: 0.85;
	}
	.top-actions {
		display: flex;
		gap: 1rem;
		margin-left: auto;
	}
	.topbar .link {
		color: inherit;
	}
	.top-actions {
		align-items: center;
	}
	.danger {
		padding: 0.3rem 0.75rem;
		border: 0;
		border-radius: 3px;
		background: var(--alarm);
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.danger:hover {
		background: #8e0c21;
	}
	#sprint-picker {
		padding: 0.25rem 0.4rem;
		border-radius: 3px;
		font: inherit;
	}
	.stuck {
		margin-left: auto;
		padding: 0.1rem 0.6rem;
		border: 0;
		border-radius: 3px;
		background: var(--tape);
		color: #1b2230;
		font: inherit;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
	}
	.stuck:disabled {
		opacity: 0.7;
		cursor: progress;
	}
	.stuck:not([hidden]) + .max {
		margin-left: 0;
	}
	#ticket-body :global(.coach) {
		margin-top: 1rem;
	}
	#ticket-body :global(.coach:empty) {
		display: none;
	}
	#ticket-body :global(.coach) {
		padding: 0.75rem 1rem;
		border-left: 4px solid var(--tape);
		background: var(--wall);
	}
	#ticket-body :global(.coach h4) {
		font-family: var(--body);
		font-size: 0.9375rem;
		letter-spacing: 0;
	}
	#ticket-body :global(.coach .steps) {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
	}
	#ticket-body :global(.coach li) {
		margin-bottom: 0.5rem;
	}
	#ticket-body :global(.coach li.done) {
		color: var(--muted);
	}
	#ticket-body :global(.coach li.current .step-text) {
		font-weight: 700;
	}
	#ticket-body :global(.coach .step-text) {
		margin: 0;
	}
	#ticket-body :global(.coach .cmd) {
		margin: 0.3rem 0 0;
		padding: 0.4rem 0.6rem;
		background: #10161f;
		color: #dfe6dd;
		font-family: var(--mono);
		font-size: 0.875rem;
		white-space: pre-wrap;
		user-select: all;
	}
	#ticket-body :global(.coach .more) {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
	/* Jonkins: a parody too. Status is in words as well as colour. */
	.jonkins {
		margin-bottom: 1rem;
		border: 2px solid #1d5c55;
		border-radius: 4px;
		overflow: hidden;
	}
	.jonkins-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
		padding: 0.4rem 0.6rem;
		background: #1d5c55;
		color: #fff;
		font-family: var(--body);
		font-size: 0.9375rem;
		letter-spacing: 0;
	}
	.jonkins-logo {
		font-family: var(--display);
		font-weight: 800;
		font-style: italic;
		font-size: 1.0625rem;
	}
	.runs {
		margin: 0;
		padding: 0.25rem 0.6rem;
		list-style: none;
		max-height: 11rem;
		overflow: auto;
		font-size: 0.875rem;
	}
	.runs :global(.empty) {
		padding: 0.25rem 0;
		color: var(--muted);
	}
	.runs :global(.run) {
		display: grid;
		grid-template-columns: auto auto 1fr;
		gap: 0 0.5rem;
		align-items: baseline;
		width: 100%;
		padding: 0.3rem 0.25rem;
		border: 0;
		border-bottom: 1px solid var(--line);
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	.runs :global(.run.chosen) {
		background: var(--ops);
	}
	.runs :global(.run-n) {
		font-family: var(--mono);
		font-weight: 700;
	}
	.runs :global(.status) {
		padding: 0 0.35rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
	}
	.runs :global(.status.success) {
		background: #1f6b35;
	}
	.runs :global(.status.failure) {
		background: #b4102a;
	}
	.runs :global(.status.running) {
		background: var(--tape);
		color: #1b2230;
	}
	.runs :global(.run-what) {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--mono);
		font-size: 0.8125rem;
	}
	.runs :global(.run-who) {
		grid-column: 3;
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.console-title {
		margin: 0;
		padding: 0.4rem 0.6rem 0.2rem;
		font-family: var(--body);
		font-size: 0.8125rem;
		letter-spacing: 0;
	}
	.console {
		margin: 0;
		padding: 0.5rem 0.6rem;
		max-height: 14rem;
		overflow: auto;
		background: #10161f;
		color: #dfe6dd;
		font-family: var(--mono);
		font-size: 0.75rem;
		line-height: 1.45;
		white-space: pre-wrap;
		word-break: break-word;
	}

	/* GitBit: a parody, so it looks like nothing real. */
	.gitbit {
		margin-bottom: 1rem;
		border: 2px solid #5b3fa8;
		border-radius: 4px;
		overflow: hidden;
	}
	.gitbit-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
		padding: 0.4rem 0.6rem;
		background: #5b3fa8;
		color: #fff;
		font-family: var(--body);
		font-size: 0.9375rem;
		letter-spacing: 0;
	}
	.gitbit-logo {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.0625rem;
	}
	#gitbit-body {
		padding: 0.5rem 0.6rem;
		font-size: 0.875rem;
	}
	#gitbit-body :global(p) {
		margin: 0 0 0.4rem;
	}
	#gitbit-body :global(ol) {
		margin: 0 0 0.6rem;
		padding: 0;
		list-style: none;
	}
	#gitbit-body :global(li) {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0 0.5rem;
		padding: 0.25rem 0;
		border-bottom: 1px solid var(--line);
	}
	#gitbit-body :global(.hash) {
		grid-row: span 2;
		color: #5b3fa8;
		font-family: var(--mono);
		font-size: 0.8125rem;
	}
	@media (prefers-color-scheme: dark) {
		#gitbit-body :global(.hash) {
			color: #c3b2f5;
		}
	}
	#gitbit-body :global(.who) {
		color: var(--muted);
		font-size: 0.8125rem;
	}
	#gitbit-body :global(.files) {
		font-family: var(--mono);
		font-size: 0.8125rem;
	}
	#next-sprint :global(.btn) {
		margin-bottom: 1rem;
	}

	.workspace,
	.stack {
		display: grid;
		min-height: 0;
		min-width: 0;
	}
	.workspace {
		padding: var(--sep);
		background: var(--line);
	}
	[role='separator'] {
		position: relative;
		background: var(--line);
		touch-action: none;
		cursor: col-resize;
	}
	.stack > [role='separator'] {
		cursor: row-resize;
	}
	[role='separator']::after {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto;
		width: 2px;
		height: 2.5rem;
		border-radius: 2px;
		background: var(--muted);
		opacity: 0.5;
	}
	.stack > [role='separator']::after {
		width: 2.5rem;
		height: 2px;
	}
	[role='separator']:hover,
	[role='separator']:focus-visible,
	[role='separator'].dragging {
		background: var(--tape);
	}

	.panel {
		display: grid;
		grid-template-rows: auto 1fr;
		min-height: 0;
		min-width: 0;
		background: var(--paper);
		border-radius: 3px;
		overflow: hidden;
	}
	.panel.maximised {
		position: fixed;
		inset: 3.25rem 0.5rem 0.5rem;
		z-index: 20;
		box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.35);
	}
	.panel-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.35rem 0.5rem 0.35rem 0.75rem;
		background: var(--cubicle);
		color: #fff;
	}
	@media (prefers-color-scheme: dark) {
		.panel-head {
			background: #2b3748;
		}
	}
	.panel-head h2 {
		margin: 0;
		font-family: var(--body);
		font-size: 0.9375rem;
		letter-spacing: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.max {
		margin-left: auto;
		padding: 0.1rem 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.5);
		border-radius: 3px;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
	}
	.max:hover {
		background: rgb(255 255 255 / 0.15);
	}
	.panel-body {
		min-height: 0;
		overflow: auto;
		padding: 0.75rem 1rem 1rem;
	}

	/* Queue */
	.burndown {
		display: grid;
		gap: 0.25rem;
		margin-bottom: 0.75rem;
	}
	.burndown label {
		font-weight: 700;
		font-size: 0.875rem;
	}
	.burndown progress {
		width: 100%;
		height: 0.6rem;
		accent-color: var(--cubicle);
	}
	.burndown p {
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.review {
		width: 100%;
		margin-bottom: 0.75rem;
	}
	.col-head {
		margin: 1rem 0 0.4rem;
		font-family: var(--body);
		font-size: 0.875rem;
		letter-spacing: 0;
		color: var(--muted);
	}
	.cards {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	:global(.card) {
		display: grid;
		gap: 0.15rem;
		width: 100%;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 3px;
		background: var(--wall);
		color: var(--ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	:global(.card:hover) {
		border-color: var(--cubicle);
	}
	:global(.card.selected) {
		border-color: var(--ink);
		box-shadow: inset 0 0 0 1px var(--ink);
	}
	:global(.card.interruption) {
		box-shadow: inset 4px 0 0 var(--alarm);
	}
	:global(.card-id) {
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.75rem;
	}
	:global(.card-title) {
		font-weight: 700;
		font-size: 0.9375rem;
		line-height: 1.3;
	}
	:global(.card-meta) {
		display: flex;
		justify-content: space-between;
		color: var(--muted);
		font-size: 0.8125rem;
	}
	:global(.points) {
		display: inline-grid;
		place-items: center;
		min-width: 1.4rem;
		height: 1.4rem;
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink);
		font-weight: 700;
		font-size: 0.75rem;
	}
	:global(.flag) {
		justify-self: start;
		padding: 0 0.4rem;
		background: var(--alarm);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
	}

	:global(.card.blocked) {
		border-style: dashed;
	}
	:global(.card.blocked .card-title) {
		color: var(--muted);
	}
	:global(.blocked-by) {
		display: inline-flex;
		gap: 0.3rem;
		align-items: center;
		justify-self: start;
		font-size: 0.75rem;
		font-weight: 700;
	}

	/* Ticket */
	#ticket-body :global(.blocked-note) {
		margin-top: 1rem;
		padding: 0.75rem 1rem;
		background: var(--ops);
		border-left: 4px solid var(--tape);
	}
	#ticket-body :global(.empty) {
		color: var(--muted);
	}
	#ticket-body :global(.ticket-title) {
		margin: 0.15rem 0 0.25rem;
		font-size: 1.5rem;
	}
	#ticket-body :global(.ticket-meta) {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	#ticket-body :global(p) {
		max-width: 60ch;
		margin: 0 0 0.6rem;
	}
	#ticket-body :global(.actions) {
		display: flex;
